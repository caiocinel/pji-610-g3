# Conexão com o PostgreSQL
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/luamme
# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Gere com: openssl rand -hex 32
SESSION_SECRET=
# Credenciais de acesso da proprietária
ADMIN_USER=luamme
ADMIN_PASSWORD=
# Cabeçalho com o IP real do visitante, sobrescrito pelo proxy (limite de tentativas de login):
# x-real-ip (padrão) | x-forwarded-for (último salto) | nenhum
LOGIN_IP_HEADER=x-real-ip
